<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Launcher.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <EnableSourceLink>false</EnableSourceLink>
    <AssemblyName>Orbitra_Launcher_Installer</AssemblyName>
    <ApplicationIcon>../SS14.Launcher/Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageVersion Remove="Microsoft.NET.ILLink.Tasks" /></ItemGroup>
  <ItemGroup Condition="'$(InstallerPayload)' != ''">
    <EmbeddedResource Include="$(InstallerPayload)" LogicalName="Orbitra.Installer.Payload.zip" />
  </ItemGroup>
  <Target Name="RequireInstallerPayload" BeforeTargets="CoreCompile" Condition="'$(InstallerPayload)' == ''">
    <Error Text="InstallerPayload must point to the compressed AOT installer payload." />
  </Target>
</Project>
