<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <Style Selector="TextBlock.NanoHeading">
    <Setter Property="Foreground" Value="{DynamicResource ThemeNanoGoldBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="30" />
  </Style>

  <Style Selector="TextBlock.SectionLabel">
    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.4" />
  </Style>

  <Style Selector="Border.Surface">
    <Setter Property="Background" Value="{DynamicResource LauncherSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LauncherLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.Surface">
    <Style.Animations>
      <Animation Duration="0:0:0.34" Easing="CubicEaseOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Panel.MotionHeader">
    <Style.Animations>
      <Animation Duration="0:0:0.42" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource LauncherSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LauncherLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBlock.NanoHeadingMedium">
    <Setter Property="Foreground" Value="{DynamicResource ThemeNanoGoldBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="20" />
  </Style>

  <Style Selector="TextBlock.NanoHeadingSmall">
    <Setter Property="Foreground" Value="{DynamicResource ThemeNanoGoldBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="TextBlock.SubText">
    <Setter Property="Foreground" Value="{DynamicResource ThemeSubTextBrush}" />
  </Style>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource LauncherFontFamily}" />
  </Style>

  <Style Selector="UserControl">
    <Setter Property="FontFamily" Value="{DynamicResource LauncherFontFamily}" />
  </Style>

  <Style Selector="TextBlock.BrandText">
    <Setter Property="FontFamily" Value="Impact, Arial Black, sans-serif" />
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="2.8" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
  </Style>

  <Style Selector="Panel.GoldLineHorizontal">
    <Setter Property="Background" Value="{DynamicResource LauncherLineBrush}" />
    <Setter Property="MinHeight" Value="1" />
  </Style>

  <Style Selector="Expander[ExpandDirection=Down] /template/ ToggleButton#PART_toggle">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Panel.ScrollViewerSep">
    <Setter Property="Background">
      <SolidColorBrush Color="{DynamicResource ThemeListSeparatorColor}" />
    </Setter>
    <Setter Property="MinHeight" Value="1" />
  </Style>

  <!-- TabItem -->
  <Style Selector="TabItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeTabItemHoveredBrush}" />
  </Style>
  <Style Selector="TabItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeTabItemSelectedBrush}" />
  </Style>
  <Style Selector="TabItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeTabItemSelectedBrush}" />
  </Style>
  <Style Selector="TabItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeTabItemSelectedBrush}" />
  </Style>
  <Style Selector="TabItem:selected:focus:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeTabItemSelectedBrush}" />
  </Style>

  <Style Selector="Button.BigButton > TextBlock">
    <Setter Property="FontSize" Value="20" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Margin" Value="4 0 0 0" />
  </Style>

  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.IconAction, ToggleButton.IconAction">
    <Setter Property="Width" Value="40" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Path.PlusIcon, Path.FavoriteIcon, Path.AccountIcon, Path.SignalIcon, Path.WindowControlIcon">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Rectangle.WindowControlIcon">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Viewbox.RefreshIcon">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>

  <Style Selector="Button:pointerover Viewbox.RefreshIcon">
    <Style.Animations>
      <Animation Duration="0:0:0.55" Easing="CubicEaseOut">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button.Connecting">
    <Setter Property="Background" Value="#303030" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Viewbox.ConnectSpinner">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Style.Animations>
      <Animation Duration="0:0:0.72" IterationCount="INFINITE" Easing="LinearEasing">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.ConnectionDock">
    <Style.Animations>
      <Animation Duration="0:0:0.36" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="24" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Viewbox.DockSpinner">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="LinearEasing">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button:pointerover Path.PlusIcon">
    <Style.Animations>
      <Animation Duration="0:0:0.26" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="90" />
          <Setter Property="ScaleTransform.ScaleX" Value="1.12" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.12" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button:pointerover Path.FavoriteIcon">
    <Style.Animations>
      <Animation Duration="0:0:0.32" Easing="CubicEaseOut">
        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
        <KeyFrame Cue="55%"><Setter Property="ScaleTransform.ScaleX" Value="1.22" /><Setter Property="ScaleTransform.ScaleY" Value="1.22" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1.08" /><Setter Property="ScaleTransform.ScaleY" Value="1.08" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Path.SignalIcon">
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.68" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.SkeletonBar">
    <Setter Property="Background" Value="{DynamicResource LauncherControlBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Style.Animations>
      <Animation Duration="0:0:1.15" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="CubicEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.28" /></KeyFrame>
        <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.42" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>


  <Style Selector="Button.WindowCommand:pointerover Path.WindowControlIcon">
    <Setter Property="RenderTransform" Value="scale(1.18)" />
  </Style>

  <Style Selector="Button.WindowCommand:pointerover Rectangle.WindowControlIcon">
    <Setter Property="RenderTransform" Value="scale(1.18)" />
  </Style>

  <Style Selector="Border.BackgroundScan">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Border.LauncherToast">
    <Setter Property="Background" Value="{DynamicResource LauncherSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LauncherLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 8 24 #A0000000" />
    <Style.Animations>
      <Animation Duration="0:0:0.28" Easing="CubicEaseOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.X" Value="24" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.LauncherToast.Error">
    <Setter Property="BorderBrush" Value="#A94A4A" />
  </Style>

  <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
    <Style.Animations>
      <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="10" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.BackgroundScan">
    <Setter Property="Opacity" Value="0.7" />
    <Style.Animations>
      <Animation Duration="0:0:7" IterationCount="INFINITE" Easing="LinearEasing">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-180" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="900" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button:pointerover, ToggleButton:pointerover">
    <Setter Property="Opacity" Value="0.92" />
  </Style>

  <Style Selector="TextBox:focus, ComboBox:focus">
    <Setter Property="Opacity" Value="0.96" />
  </Style>

  <Style Selector="Button:pressed, ToggleButton:pressed">
    <Setter Property="RenderTransform" Value="translateY(1px)" />
  </Style>

  <Style Selector="Button.WindowCommand">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.WindowCommand:pointerover">
    <Setter Property="Background" Value="{DynamicResource LauncherHoverBrush}" />
  </Style>

  <Style Selector="Button.WindowCommand.Close:pointerover">
    <Setter Property="Background" Value="#9E3B32" />
  </Style>

  <Style Selector="Button:disabled, ToggleButton:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector=":is(Control).MainWindowHeader">
    <Setter Property="Margin" Value="4, 8, 0, 0" />
  </Style>
  <Style Selector=".WindowsTitlebarColorActive :is(Control).MainWindowHeader">
    <Setter Property="Margin" Value="4, 0, 0, 0" />
  </Style>
</Styles>
