<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SS14.Launcher.Views">
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource LauncherControlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background"
                Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource LauncherLineBrush}"
                BorderThickness="1"
                CornerRadius="0">
          <Panel Name="PART_Margin">
            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              TextBlock.Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Setter Property="Padding" Value="0, 6" />
    <Setter Property="Margin" Value="1" />
  </Style>
  <Style Selector="Button /template/ Panel#PART_Margin">
    <Setter Property="Margin" Value="14 0" />
  </Style>

  <Style Selector="Button.OpenLeft">
    <Setter Property="Padding" Value="10, 2, 0, 2" />
  </Style>
  <Style Selector="Button.OpenLeft /template/ Panel#PART_Margin">
    <Setter Property="Margin" Value="0 0 14 0" />
  </Style>

  <Style Selector="Button.OpenRight">
    <Setter Property="Padding" Value="0, 2, 10, 2" />
  </Style>
  <Style Selector="Button.OpenRight /template/ Panel#PART_Margin">
    <Setter Property="Margin" Value="14 0 0 0" />
  </Style>

  <Style Selector="Button.OpenBoth">
    <Setter Property="Padding" Value="10, 2" />
  </Style>
  <Style Selector="Button.OpenBoth /template/ Panel#PART_Margin">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource ThemeButtonHoveredBrush}" />
  </Style>

  <Style Selector="Button:pointerover /template/ Border#PART_Background">
    <Setter Property="BorderBrush" Value="{DynamicResource LauncherTextBrush}" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeBackgroundBrush}" />
  </Style>
</Styles>
