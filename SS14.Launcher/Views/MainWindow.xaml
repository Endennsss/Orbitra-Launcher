<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SS14.Launcher.Views"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        MinWidth="960" MinHeight="600"
        Width="1180" Height="720"
        x:Class="SS14.Launcher.Views.MainWindow"
        Icon="{DynamicResource WindowIcon}"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="40,*" ClipToBounds="True">
    <Border Grid.Row="0" Background="{DynamicResource LauncherChromeBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,0,0,1"
            PointerPressed="TitleBarPressed">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0" Spacing="9">
          <Border Width="18" Height="18" Background="{DynamicResource LauncherWorkspaceBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1">
            <Viewbox Margin="3">
              <Path Data="M8,7.3107 L1,14.3107 L1,15.3107 L2,15.3107 L9,8.3107 M7,6.3107 L5.18931,4.50001 L8.68931,1 L14,6.31069 L14.5,10.3107 L13,11.8107 L10,9.31069 M9,3.31069 L9.5,3.81069"
                    Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1" StrokeLineCap="Round" />
            </Viewbox>
          </Border>
          <TextBlock Text="SPACE STATION 14" VerticalAlignment="Center"
                     FontSize="11" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource ThemeSubTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="WindowCommand" Width="46" Height="40" Padding="0" Margin="0"
                  Click="MinimizeClicked" ToolTip.Tip="Свернуть">
            <Path Classes="WindowControlIcon" Data="M 0,0 L 10,0" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.2" />
          </Button>
          <Button Classes="WindowCommand" Width="46" Height="40" Padding="0" Margin="0"
                  Click="MaximizeClicked" ToolTip.Tip="Развернуть">
            <Rectangle Classes="WindowControlIcon" Width="10" Height="9" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.2" />
          </Button>
          <Button Classes="WindowCommand Close" Width="46" Height="40" Padding="0" Margin="0"
                  Click="CloseClicked" ToolTip.Tip="Закрыть">
            <Path Classes="WindowControlIcon" Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.2" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" Name="LauncherHost">
      <views:MainWindowContent Name="LauncherContent" />
    </ContentControl>
  </Grid>
</Window>
