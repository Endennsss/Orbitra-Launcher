<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SS14.Launcher.Views"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        MinWidth="960" MinHeight="600"
        Width="1180" Height="720"
        x:Class="SS14.Launcher.Views.MainWindow"
        Icon="{DynamicResource WindowIcon}"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="40,*" ClipToBounds="True">
    <Border Grid.Row="0" Background="{DynamicResource LauncherChromeBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,0,0,1"
            PointerPressed="TitleBarPressed">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0" Spacing="8">
          <Border Width="32" Height="32" CornerRadius="8" ClipToBounds="True"
                  Background="#000000" IsHitTestVisible="False">
            <Image Source="{DynamicResource OrbitraLogo}"
                   Stretch="UniformToFill" IsHitTestVisible="False" />
          </Border>
          <TextBlock Text="ORBITRA LAUNCHER" VerticalAlignment="Center"
                     FontSize="11" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource ThemeSubTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="WindowCommand" Width="46" Height="40" Padding="0" Margin="0"
                  Click="MinimizeClicked" ToolTip.Tip="Свернуть">
            <Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Classes="WindowCommand" Width="46" Height="40" Padding="0" Margin="0"
                  Click="MaximizeClicked" ToolTip.Tip="Развернуть">
            <Rectangle Classes="WindowControlIcon" Width="10" Height="9" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.2" />
          </Button>
          <Button Classes="WindowCommand Close" Width="46" Height="40" Padding="0" Margin="0"
                  Click="CloseClicked" ToolTip.Tip="Закрыть">
            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(45deg)"/><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(-45deg)"/></Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" Name="LauncherHost">
      <views:MainWindowContent Name="LauncherContent" />
    </ContentControl>
  </Grid>
</Window>
