<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:v="clr-namespace:SS14.Launcher.Views"
             x:Class="SS14.Launcher.Views.MainWindowTabs.ProfileTabView">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid Classes="MotionHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Spacing="3">
        <TextBlock Text="ORBITRA ID" Classes="SectionLabel"/>
        <TextBlock Text="Профиль" Classes="NanoHeadingMedium"/>
        <TextBlock Text="Ваш профиль, друзья и публикации в одном месте" Classes="SubText"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Настроить профиль" Command="{Binding OpenProfileSettings}"
              VerticalAlignment="Bottom"/>
    </Grid>

    <Border Grid.Row="1" Classes="Surface MotionCard" ClipToBounds="True">
      <Grid RowDefinitions="122,Auto">
        <Border Background="{DynamicResource LauncherChromeBrush}">
          <Grid>
            <Image Source="{Binding Banner}" Stretch="UniformToFill"/>
            <Border VerticalAlignment="Bottom" Height="54">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00101010" Offset="0"/>
                  <GradientStop Color="#D9101010" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="112,*,Auto" Margin="20,0,20,18">
          <Grid Width="92" Height="92" Margin="0,-34,0,0" ZIndex="2">
            <Ellipse Fill="{DynamicResource LauncherSurfaceAltBrush}" Stroke="{DynamicResource LauncherLineBrush}" StrokeThickness="3"/>
            <TextBlock Text="{Binding UsernameInitial}" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Stroke="{DynamicResource LauncherLineBrush}" StrokeThickness="3">
              <Ellipse.Fill><ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill"/></Ellipse.Fill>
            </Ellipse>
          </Grid>
          <StackPanel Grid.Column="1" Margin="12,10,20,0" Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Username}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/>
              <v:CreatorBadge Width="22" Height="22" IsVisible="{Binding IsCreator}" VerticalAlignment="Center"/>
              <Border Height="23" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1"
                      Padding="9,0" IsVisible="{Binding OwnIsOnline}" VerticalAlignment="Center">
                <TextBlock Text="ОНЛАЙН" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}"
                           VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding DescriptionDisplay}" Classes="SubText" TextWrapping="Wrap" MaxLines="2"/>
          </StackPanel>
          <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto" Margin="0,13,0,0">
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="ИГРОВОЕ ВРЕМЯ" Classes="SectionLabel"/>
              <TextBlock Text="{Binding TotalPlaytime}" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="СЕРВЕРОВ" Classes="SectionLabel"/>
              <TextBlock Text="{Binding ServersPlayed}" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <TabControl Grid.Row="2" Margin="0,10,0,0">
      <TabItem Header="Обзор">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Grid ColumnDefinitions="1.35*,*" RowDefinitions="Auto" Margin="0,10,0,0" VerticalAlignment="Top">
            <Border Classes="Surface MotionCard" Padding="15" Margin="0,0,5,0" VerticalAlignment="Top">
              <StackPanel Spacing="6">
                <TextBlock Text="О СЕБЕ" Classes="SectionLabel"/>
                <TextBlock Text="{Binding DescriptionDisplay}" TextWrapping="Wrap" FontSize="14"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="Surface MotionCard" Padding="15" Margin="5,0,0,0" VerticalAlignment="Top">
              <StackPanel Spacing="6">
                <TextBlock Text="ЛЮБИМЫЙ СЕРВЕР" Classes="SectionLabel"/>
                <TextBlock Text="{Binding SelectedFavoriteServer.Name}" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Изменить можно в настройках профиля" Classes="SubText"/>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Друзья">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <Border Classes="Surface MotionCard" Padding="18">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Text="НАЙТИ ПОЛЬЗОВАТЕЛЯ" Classes="SectionLabel"/>
                    <TextBlock Text="Введите точный ник аккаунта Space Station 14" Classes="SubText"/>
                  </StackPanel>
                  <Grid Grid.Column="1" ColumnDefinitions="280,Auto" VerticalAlignment="Center">
                    <TextBox Watermark="Ник пользователя" Text="{Binding Search,Mode=TwoWay}"/>
                    <Button Grid.Column="1" Content="Найти" Command="{Binding FindUser}" Margin="8,0,0,0"/>
                  </Grid>
                </Grid>

                <Border IsVisible="{Binding HasFoundProfile}" Background="{DynamicResource LauncherSurfaceAltBrush}"
                        BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" Padding="12">
                  <Grid ColumnDefinitions="48,*,Auto" MinHeight="48">
                    <Grid Width="42" Height="42">
                      <Ellipse Fill="{DynamicResource LauncherSurfaceBrush}"/>
                      <TextBlock Text="{Binding FoundInitial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Ellipse><Ellipse.Fill><ImageBrush Source="{Binding FoundAvatar}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,16,0" VerticalAlignment="Center" Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding FoundProfile.Username}" FontSize="17" FontWeight="Bold"/>
                        <v:CreatorBadge Width="18" Height="18" IsVisible="{Binding FoundProfileIsCreator}"/>
                        <TextBlock Text="ОНЛАЙН" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}"
                                   VerticalAlignment="Center" IsVisible="{Binding FoundIsOnline}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding FoundRelationshipText}" Classes="SubText"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="Открыть профиль" Command="{Binding OpenFoundProfile}"/>
                      <Button Content="Принять" Command="{Binding AcceptFoundFriend}" IsVisible="{Binding CanAcceptFoundFriend}"/>
                      <Button Content="Добавить в друзья" Command="{Binding AddFoundFriend}" IsVisible="{Binding CanAddFoundFriend}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="Surface" Padding="18">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Text="ДРУЗЬЯ И ЗАЯВКИ" Classes="SectionLabel"/>
                    <TextBlock Text="{Binding Status}" Classes="SubText"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Обновить" Command="{Binding Refresh}"/>
                </Grid>
                <TextBlock Text="Здесь появятся друзья и входящие заявки." Classes="SubText"
                           HorizontalAlignment="Center" Margin="0,24" IsVisible="{Binding !HasFriends}"/>
                <ItemsControl Classes="MotionList" ItemsSource="{Binding Friends}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrbitraFriendItemViewModel">
                      <Border Classes="MotionCard" Background="{DynamicResource LauncherSurfaceAltBrush}"
                              BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" Padding="12" Margin="0,3">
                        <Grid ColumnDefinitions="48,190,*,Auto" MinHeight="48">
                          <Border Width="40" Height="40" Background="{DynamicResource LauncherSurfaceBrush}"
                                  BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Username}" FontWeight="Bold"/>
                              <v:CreatorBadge Width="17" Height="17" IsVisible="{Binding IsCreator}"/>
                              <TextBlock Text="ОНЛАЙН" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}"
                                         VerticalAlignment="Center" IsVisible="{Binding IsOnline}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding State}" Classes="SubText"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding ServerText}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Classes="SubText"/>
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Button Content="Профиль" Command="{Binding ViewProfile}"/>
                            <Button Content="Принять" Command="{Binding Accept}" IsVisible="{Binding IsIncoming}"/>
                            <Button Content="Подключиться" Command="{Binding Connect}" IsVisible="{Binding CanConnect}"/>
                            <Button Content="Пригласить" Command="{Binding Invite}" IsVisible="{Binding CanInvite}"/>
                            <Button Content="Ссылка" Command="{Binding CopyInvite}" IsVisible="{Binding CanConnect}"/>
                            <Button Content="Удалить" Command="{Binding Remove}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Мои темы">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Border Classes="Surface MotionCard" Padding="20" Margin="0,12,0,0">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="МОИ ТЕМЫ" Classes="SectionLabel"/>
                  <TextBlock Text="Опубликованные вами оформления мастерской" Classes="SubText"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Открыть мастерскую" Command="{Binding OpenThemeWorkshop}"/>
              </Grid>
              <TextBlock Text="У вас пока нет опубликованных тем." Classes="SubText"
                         HorizontalAlignment="Center" Margin="0,24" IsVisible="{Binding !HasMyThemes}"/>
              <ItemsControl Classes="MotionList" ItemsSource="{Binding MyThemes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileThemeItemViewModel">
                    <Border Classes="MotionCard" Background="{DynamicResource LauncherSurfaceAltBrush}"
                            BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" Padding="14" Margin="0,3">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Description}" Classes="SubText" TextWrapping="Wrap" MaxLines="2"/>
                          <TextBlock Text="{Binding Meta}" Classes="SubText"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Content="Открыть" Command="{Binding Open}"/>
                          <Button Content="Редактировать" Command="{Binding Edit}" IsVisible="{Binding IsOwn}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
