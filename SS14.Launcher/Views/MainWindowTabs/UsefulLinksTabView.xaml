<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="520"
             x:Class="SS14.Launcher.Views.MainWindowTabs.UsefulLinksTabView">
  <Design.DataContext><vm:UsefulLinksTabViewModel /></Design.DataContext>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <StackPanel Margin="0,0,0,4">
        <TextBlock Text="RESOURCES" Classes="SectionLabel" />
        <TextBlock Text="Полезные ссылки" Classes="NanoHeadingMedium" />
        <TextBlock Text="Сервисы проекта и официальные ресурсы Space Station 14."
                   Classes="SubText" Margin="0,4,0,0" />
      </StackPanel>

      <Border Classes="Surface" Padding="20">
        <Grid ColumnDefinitions="52,*,Auto">
          <Border Width="42" Height="42" Background="{DynamicResource LauncherControlBrush}"
                  BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1">
            <Viewbox Width="21" Height="21">
              <Canvas Width="24" Height="24">
                <!-- Official Lucide "atom". -->
                <Path Data="M20.2,20.2 C22.24,18.17 20.22,12.63 15.7,7.84 C11.22,3.04 5.67,1.02 3.63,3.06 C1.6,5.1 3.61,10.64 8.4,15.42 C13.2,20.22 18.16,22.24 20.2,20.2 M15.7,15.7 C20.49,10.9 22.51,5.36 20.47,3.32 C18.43,1.29 12.89,3.31 8.09,8.11 C3.29,12.91 1.27,18.45 3.31,20.49 C5.35,22.52 10.89,20.5 15.7,15.7"
                      Fill="Transparent" Stroke="{DynamicResource ThemeForegroundBrush}"
                      StrokeThickness="1.8" StrokeLineCap="Round" />
                <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="Transparent"
                         Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.8" />
              </Canvas>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock Text="ChemHelper" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Background="{DynamicResource LauncherControlBrush}" BorderBrush="{DynamicResource LauncherLineBrush}"
                      BorderThickness="1" Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="ПРОЕКТ АВТОРА" Classes="SectionLabel" FontSize="9" />
              </Border>
            </StackPanel>
            <TextBlock Text="Отдельный проект автора лаунчера - помощник по химии для Space Station 14."
                       Classes="SubText" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Content="Открыть ChemHelper" Command="{Binding OpenChemHelper}"
                  MinWidth="180" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <TextBlock Text="ORBITRA LAUNCHER" Classes="SectionLabel" Margin="0,6,0,0" />
      <UniformGrid Columns="2">
        <Button Margin="0,0,6,6" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding OpenLauncherSite}">
          <StackPanel><TextBlock Text="Сайт лаунчера" FontWeight="SemiBold" /><TextBlock Text="Описание и возможности проекта" Classes="SubText" /></StackPanel>
        </Button>
        <Button Margin="6,0,0,6" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding DownloadLatestLauncher}">
          <StackPanel><TextBlock Text="Скачать последнюю версию" FontWeight="SemiBold" /><TextBlock Text="Прямая загрузка Windows ZIP" Classes="SubText" /></StackPanel>
        </Button>
        <Button Margin="0,6,6,6" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding OpenLauncherReleases}">
          <StackPanel><TextBlock Text="Релизы" FontWeight="SemiBold" /><TextBlock Text="Версии и списки изменений" Classes="SubText" /></StackPanel>
        </Button>
        <Button Margin="6,6,0,6" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding OpenLauncherGitHub}">
          <StackPanel><TextBlock Text="GitHub лаунчера" FontWeight="SemiBold" /><TextBlock Text="Исходный код проекта" Classes="SubText" /></StackPanel>
        </Button>
        <Button Margin="0,6,6,0" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding OpenLauncherIssues}">
          <StackPanel><TextBlock Text="Сообщить о проблеме" FontWeight="SemiBold" /><TextBlock Text="Ошибки и предложения на GitHub" Classes="SubText" /></StackPanel>
        </Button>
        <Button Margin="6,6,0,0" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding OpenLauncherActions}">
          <StackPanel><TextBlock Text="Состояние сборок" FontWeight="SemiBold" /><TextBlock Text="GitHub Actions и публикации" Classes="SubText" /></StackPanel>
        </Button>
      </UniformGrid>

      <TextBlock Text="SPACE STATION 14" Classes="SectionLabel" Margin="0,6,0,0" />
      <UniformGrid Columns="2">
        <Button Margin="0,0,6,6" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding OpenSs14Website}">
          <StackPanel><TextBlock Text="Официальный сайт" FontWeight="SemiBold" /><TextBlock Text="Новости и информация SS14" Classes="SubText" /></StackPanel>
        </Button>
        <Button Margin="6,0,0,6" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding OpenAccount}">
          <StackPanel><TextBlock Text="Управление аккаунтом" FontWeight="SemiBold" /><TextBlock Text="Профиль и параметры входа" Classes="SubText" /></StackPanel>
        </Button>
        <Button Margin="0,6,6,0" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding OpenDocumentation}">
          <StackPanel><TextBlock Text="Документация" FontWeight="SemiBold" /><TextBlock Text="Руководства Space Station 14" Classes="SubText" /></StackPanel>
        </Button>
        <Button Margin="6,6,0,0" Padding="18" HorizontalContentAlignment="Stretch" Command="{Binding OpenGitHub}">
          <StackPanel><TextBlock Text="GitHub" FontWeight="SemiBold" /><TextBlock Text="Исходный код игры" Classes="SubText" /></StackPanel>
        </Button>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
