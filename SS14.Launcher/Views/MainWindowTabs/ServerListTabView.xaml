<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:mainWindowTabsViews="clr-namespace:SS14.Launcher.Views.MainWindowTabs"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             xmlns:views="clr-namespace:SS14.Launcher.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SS14.Launcher.Views.MainWindowTabs.ServerListTabView">
  <Design.DataContext>
    <mainWindowTabs:ServerListTabViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector=":is(mainWindowTabsViews|ServerList).filtersClosed">
      <Setter Property="Grid.RowSpan" Value="3"></Setter>
    </Style>
    <Style Selector="Border.ServerStatChip">
      <Setter Property="Background" Value="{DynamicResource LauncherSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LauncherLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,6" />
    </Style>
    <Style Selector="Border.ServerStatChip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeSubTextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.ServerSearchBox">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="10,0,2,0" />
      <Setter Property="Background" Value="{DynamicResource LauncherSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LauncherLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.18" /></Transitions></Setter>
    </Style>
    <Style Selector="Border.ServerSearchBox:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="Button.SearchClear">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.ServerFiltersButton">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="132" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="Background" Value="{DynamicResource LauncherSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LauncherLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.ServerFiltersButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource LauncherSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel LastChildFill="True">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="NETWORK" Classes="SectionLabel" />
        <TextBlock Text="{loc:Loc tab-servers-table-name}" Classes="NanoHeadingMedium" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Border Classes="ServerStatChip"><TextBlock Text="{Binding OnlineCountText}" /></Border>
        <Border Classes="ServerStatChip"><TextBlock Text="{Binding ResultCountText}" /></Border>
      </StackPanel>
    </Grid>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <Border Classes="ServerSearchBox" Margin="0,0,10,0">
        <Grid ColumnDefinitions="28,*,38">
          <!-- Official Lucide search icon. -->
          <Viewbox Width="18" Height="18" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M21,21 L16.65,16.65 M19,11 A8,8 0 1 1 3,11 A8,8 0 0 1 19,11 Z" Fill="Transparent" Stroke="{DynamicResource ThemeSubTextBrush}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
          <TextBox Name="SearchBox" Grid.Column="1" Text="{Binding SearchString, Mode=TwoWay}"
                   Watermark="Название, адрес, карта, режим или описание"
                   UseFloatingWatermark="False" Background="Transparent" BorderThickness="0" Padding="6,0"
                   VerticalContentAlignment="Center" VerticalAlignment="Stretch" />
          <Button Grid.Column="2" Classes="SearchClear" Command="{Binding ClearSearch}" IsVisible="{Binding HasSearch}" ToolTip.Tip="Очистить поиск">
            <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M18,6 L6,18 M6,6 L18,18" Fill="Transparent" Stroke="{DynamicResource ThemeSubTextBrush}" StrokeThickness="2" StrokeLineCap="Round"/></Canvas></Viewbox>
          </Button>
        </Grid>
      </Border>
      <Button Grid.Column="1" Command="{Binding ToggleFilters}" Classes="ServerFiltersButton">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <!-- Official Lucide sliders-horizontal icon. -->
          <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M21,4 L14,4 M10,4 L3,4 M21,12 L12,12 M8,12 L3,12 M21,20 L16,20 M12,20 L3,20 M14,2 L14,6 M8,10 L8,14 M16,18 L16,22" Fill="Transparent" Stroke="{DynamicResource ThemeSubTextBrush}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
          <TextBlock Text="{Binding Filters.FilterSummaryText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Classes="Surface">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="180" /> <!-- Server List -->
        <RowDefinition Height="4" /> <!-- Grabber -->
        <RowDefinition MinHeight="150" /> <!-- Filters Pane -->
      </Grid.RowDefinitions>

      <!-- Main server list table -->
      <mainWindowTabsViews:ServerList Grid.Row="0" DockPanel.Dock="Top" List="{Binding SearchedServers}"
                                      ListText="{Binding ListText}"
                                      SpinnerVisible="{Binding SpinnerVisible}"
                                      ShowHeader="True"
                                      Classes.filtersClosed="{Binding !FiltersVisible}" />

      <GridSplitter Grid.Row="1" BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Rows"
                    IsVisible="{Binding FiltersVisible}">
      </GridSplitter>

      <!-- Filters dialog -->
      <Border Grid.Row="2" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,1,0,0"
              IsVisible="{Binding FiltersVisible}"
              BoxShadow="0 -8 24 #70000000">
        <Panel Background="{DynamicResource LauncherWorkspaceBrush}">
          <mainWindowTabsViews:ServerListFiltersView DataContext="{Binding Filters}" />
        </Panel>
      </Border>
    </Grid>
    </Border>
  </DockPanel>
</UserControl>
