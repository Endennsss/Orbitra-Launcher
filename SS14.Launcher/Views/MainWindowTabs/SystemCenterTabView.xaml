<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             x:Class="SS14.Launcher.Views.MainWindowTabs.SystemCenterTabView">
  <Grid RowDefinitions="Auto,*">
    <Grid Classes="MotionHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="ORBITRA CONTROL" Classes="SectionLabel"/>
        <TextBlock Text="Система, диагностика и производительность" Classes="NanoHeadingMedium"/>
        <TextBlock Text="{Binding CurrentVersion, StringFormat='Текущая версия: {0}'}" Classes="SubText"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Обновить показатели" Command="{Binding RefreshPerformance}"
              VerticalAlignment="Bottom"/>
    </Grid>

    <TabControl Grid.Row="1">
      <TabItem Header="Обзор">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
            <Border Classes="Surface MotionCard" Padding="18" Margin="0,0,6,0">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="ЦЕЛОСТНОСТЬ" Classes="SectionLabel"/>
                  <Button Grid.Column="1" Content="Проверить" Command="{Binding RunIntegrity}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Integrity}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="24,130,*" Margin="0,3">
                        <TextBlock Text="{Binding Marker}" Foreground="{Binding Color}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding Details}" Classes="SubText" TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Экспортировать обезличенный отчёт" Command="{Binding ExportErrorReport}"
                        HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="Surface MotionCard" Padding="18" Margin="6,0,0,0">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="СТАТУС СЛУЖБ" Classes="SectionLabel"/>
                  <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshServices}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Services}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="24,165,*" Margin="0,3">
                        <TextBlock Text="{Binding Marker}" Foreground="{Binding Color}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Details}" Classes="SubText" TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Диагностика запуска">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <Border Classes="Surface MotionCard" Padding="18">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="УМНАЯ ДИАГНОСТИКА" Classes="SectionLabel"/>
                  <TextBlock Text="Orbitra читает последние журналы клиента и ищет конкретную причину сбоя. Данные никуда не отправляются."
                             Classes="SubText" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Анализировать снова" Command="{Binding AnalyzeLaunchLogs}"/>
              </Grid>
            </Border>

            <ItemsControl Classes="MotionList" ItemsSource="{Binding LaunchDiagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="Surface MotionCard" Padding="18" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="38,*" RowDefinitions="Auto,Auto,Auto,Auto">
                      <Border Width="26" Height="26" BorderBrush="{Binding Color}" BorderThickness="1"
                              HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Marker}" Foreground="{Binding Color}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                      </Border>
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" Classes="NanoHeadingSmall"/>
                        <TextBlock Grid.Column="1" Text="{Binding Severity}" Foreground="{Binding Color}" Classes="SectionLabel"/>
                      </Grid>
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details}" Classes="SubText" Margin="0,4,0,0"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Evidence}" IsVisible="{Binding HasEvidence}"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                 Background="{DynamicResource LauncherBackgroundBrush}" Padding="10"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Диск">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <Border Classes="Surface MotionCard" Padding="18">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel>
                    <TextBlock Text="МЕНЕДЖЕР ДИСКОВОГО ПРОСТРАНСТВА" Classes="SectionLabel"/>
                    <TextBlock Text="Выберите только безопасно очищаемые категории и сначала посмотрите предпросмотр." Classes="SubText"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Пересчитать" Command="{Binding ScanDisk}" Margin="6,0"/>
                  <Button Grid.Column="2" Content="Предпросмотр очистки" Command="{Binding PreviewDiskCleanup}" Margin="6,0"/>
                </Grid>

                <ItemsControl Classes="MotionList" ItemsSource="{Binding DiskUsage}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,1,0,0" Padding="4,11">
                        <Grid ColumnDefinitions="36,180,*,130">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanClean}"
                                    VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Details}" Classes="SubText" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Path}" Classes="SubText" FontFamily="Consolas" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding Size}" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="Surface MotionCard" Padding="18" IsVisible="{Binding IsCleanupPreviewVisible}"
                    BorderBrush="#D6A84B" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="5">
                  <TextBlock Text="ПРЕДПРОСМОТР ОЧИСТКИ" Classes="SectionLabel" Foreground="#D6A84B"/>
                  <TextBlock Text="{Binding CleanupPreviewText}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Отмена" Command="{Binding CancelCleanup}" Margin="8,0"/>
                <Button Grid.Column="2" Content="Подтвердить очистку" Command="{Binding ConfirmCleanup}"/>
              </Grid>
            </Border>

            <Border Classes="Surface MotionCard" Padding="18">
              <Grid RowDefinitions="Auto,Auto,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <!-- Official Lucide files icon. -->
                  <Viewbox Width="22" Height="22" Margin="0,0,11,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Data="M20,7 L20,5 A2,2 0 0 0 18,3 L6,3 A2,2 0 0 0 4,5 L4,17 A2,2 0 0 0 6,19 L8,19 M16,21 L10,21 A2,2 0 0 1 8,19 L8,9 A2,2 0 0 1 10,7 L18,7 A2,2 0 0 1 20,9 L20,19 A2,2 0 0 1 18,21 Z"
                            Fill="Transparent" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.7" StrokeLineCap="Round"/>
                    </Canvas>
                  </Viewbox>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="ДЕДУПЛИКАЦИЯ КОНТЕНТА" Classes="SectionLabel"/>
                    <TextBlock Text="Orbitra хранит один экземпляр одинакового файла для всех версий и серверов."
                               Classes="SubText" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="Анализировать" Command="{Binding AnalyzeDuplicateContent}"
                          IsEnabled="{Binding !IsDeduplicationRunning}" Margin="8,0"/>
                  <Button Grid.Column="3" Content="Оптимизировать" Command="{Binding OptimizeDuplicateContent}"
                          IsEnabled="{Binding !IsDeduplicationRunning}"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,14,0,0">
                  <Border Classes="SurfaceAlt" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" Padding="13" Margin="0,0,5,0">
                    <StackPanel Spacing="3"><TextBlock Text="ЭКОНОМИЯ" Classes="SectionLabel"/><TextBlock Text="{Binding DeduplicationSavings}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="SurfaceAlt" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" Padding="13" Margin="5,0,0,0">
                    <StackPanel Spacing="3"><TextBlock Text="СОВПАДЕНИЯ" Classes="SectionLabel"/><TextBlock Text="{Binding DeduplicationFiles}" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                  </Border>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,11,0,0" Spacing="6">
                  <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsDeduplicationRunning}"/>
                  <TextBlock Text="{Binding DeduplicationStatus}" Classes="SubText" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Surface" Padding="18">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                  <StackPanel>
                    <TextBlock Text="КОНТЕНТ СЕРВЕРОВ" Classes="SectionLabel"/>
                    <TextBlock Text="{Binding ContentDatabaseSize}" Classes="SubText"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshServerContent}" Margin="6,0"/>
                  <Button Grid.Column="2" Content="Выбрать старше 30 дней" Command="{Binding SelectOldContent}" Margin="6,0"/>
                  <Button Grid.Column="3" Content="Удалить выбранное" Command="{Binding DeleteSelectedContent}"
                          IsEnabled="{Binding HasSelectedContent}" Margin="6,0"/>
                  <Button Grid.Column="4" Content="Очистить всё" Command="{Binding DeleteAllContent}" Margin="6,0"/>
                </Grid>
                <Grid ColumnDefinitions="32,1.4*,1.2*,90,120,140" Margin="4,6,4,2">
                  <TextBlock Grid.Column="1" Text="Сервер / форк" Classes="SubText"/>
                  <TextBlock Grid.Column="2" Text="Версия и движок" Classes="SubText"/>
                  <TextBlock Grid.Column="3" Text="Размер" Classes="SubText"/>
                  <TextBlock Grid.Column="4" Text="Файлы" Classes="SubText"/>
                  <TextBlock Grid.Column="5" Text="Использовалось" Classes="SubText"/>
                </Grid>
                <ItemsControl Classes="MotionList" ItemsSource="{Binding ServerContent}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,1,0,0" Padding="4,9">
                        <Grid ColumnDefinitions="32,1.4*,1.2*,90,120,140">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding !InUse}"/>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ForkId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="ИСПОЛЬЗУЕТСЯ КЛИЕНТОМ" Classes="SubText" Foreground="#D6A84B" IsVisible="{Binding InUse}"/>
                            <TextBlock Text="{Binding AgeStatus}" Classes="SubText" Foreground="#D6A84B" IsVisible="{Binding IsOld}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding ForkVersion}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Engine, StringFormat='Engine {0}'}" Classes="SubText"/>
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding Size}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="{Binding Files}" Classes="SubText" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="5" Text="{Binding LastUsed}" Classes="SubText" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Производительность">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <Border Classes="Surface MotionCard" Padding="18">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="ЦЕНТР ПРОИЗВОДИТЕЛЬНОСТИ" Classes="SectionLabel"/>
                    <TextBlock Text="Локальные измерения текущего сеанса. Телеметрия не отправляется в интернет." Classes="SubText"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Обновить показатели" Command="{Binding RefreshPerformance}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding PerformanceMetrics}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="248" MinHeight="104" Classes="SurfaceAlt MotionCard" Padding="14" Margin="0,0,8,8">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Title}" Classes="SectionLabel"/>
                          <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Details}" Classes="SubText" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="Surface MotionCard" Padding="18">
              <StackPanel Spacing="10">
                <TextBlock Text="САМЫЕ МЕДЛЕННЫЕ ОПЕРАЦИИ" Classes="SectionLabel"/>
                <Grid ColumnDefinitions="*,120,100" Margin="0,4">
                  <TextBlock Text="Операция" Classes="SubText"/>
                  <TextBlock Grid.Column="1" Text="Время" Classes="SubText"/>
                  <TextBlock Grid.Column="2" Text="Запуск" Classes="SubText" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl Classes="MotionList" ItemsSource="{Binding SlowOperations}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                        <Grid ColumnDefinitions="*,120,100">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Details}" Classes="SubText"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Duration}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Classes="SubText"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Обновления">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Border Classes="Surface MotionCard" Padding="18" Margin="0,12,0,0">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ИСТОРИЯ ОБНОВЛЕНИЙ" Classes="SectionLabel"/>
                <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshReleases}"/>
              </Grid>
              <ItemsControl Classes="MotionList" ItemsSource="{Binding Releases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="110,*,100,110" Margin="0,2">
                      <Button Content="{Binding Version}" Command="{Binding Install}" IsEnabled="{Binding CanInstall}"
                              FontWeight="Bold" HorizontalContentAlignment="Left" ToolTip.Tip="Установить выбранную версию"/>
                      <Button Grid.Column="1" Content="{Binding Name}" Command="{Binding Open}" HorizontalContentAlignment="Left"/>
                      <TextBlock Grid.Column="2" Text="{Binding Date}" Classes="SubText" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Margin="8,0"/>
                      <Button Grid.Column="3" Content="{Binding ActionText}" Command="{Binding Install}" IsEnabled="{Binding CanInstall}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
