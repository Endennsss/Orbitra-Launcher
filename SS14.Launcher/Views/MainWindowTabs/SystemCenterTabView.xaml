<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             x:Class="SS14.Launcher.Views.MainWindowTabs.SystemCenterTabView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <StackPanel><TextBlock Text="ORBITRA CONTROL" Classes="SectionLabel"/><TextBlock Text="Система и обновления" Classes="NanoHeadingMedium"/><TextBlock Text="{Binding CurrentVersion, StringFormat='Текущая версия: {0}'}" Classes="SubText"/></StackPanel>
      <Grid ColumnDefinitions="*,*">
        <Border Classes="Surface" Padding="18" Margin="0,0,6,0"><StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="ЦЕЛОСТНОСТЬ" Classes="SectionLabel"/><Button Grid.Column="1" Content="Проверить" Command="{Binding RunIntegrity}"/></Grid>
          <ItemsControl ItemsSource="{Binding Integrity}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="24,130,*" Margin="0,3"><TextBlock Text="{Binding Marker}" Foreground="{Binding Color}"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Details}" Classes="SubText" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Button Content="Экспортировать обезличенный отчёт" Command="{Binding ExportErrorReport}" HorizontalAlignment="Left"/>
        </StackPanel></Border>
        <Border Grid.Column="1" Classes="Surface" Padding="18" Margin="6,0,0,0"><StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="СТАТУС СЛУЖБ" Classes="SectionLabel"/><Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshServices}"/></Grid>
          <ItemsControl ItemsSource="{Binding Services}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="24,130,*" Margin="0,3"><TextBlock Text="{Binding Marker}" Foreground="{Binding Color}"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Details}" Classes="SubText" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
      </Grid>
      <Border Classes="Surface" Padding="18"><StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="ИСТОРИЯ ОБНОВЛЕНИЙ" Classes="SectionLabel"/><Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshReleases}"/></Grid>
        <ItemsControl ItemsSource="{Binding Releases}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding Open}" Margin="0,2" HorizontalContentAlignment="Stretch"><Grid ColumnDefinitions="90,*,100"><TextBlock Text="{Binding Version}" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding Date}" Classes="SubText" HorizontalAlignment="Right"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Classes="Surface" Padding="18"><StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <StackPanel><TextBlock Text="КОНТЕНТ СЕРВЕРОВ" Classes="SectionLabel"/><TextBlock Text="{Binding ContentDatabaseSize}" Classes="SubText"/></StackPanel>
          <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshServerContent}" Margin="6,0"/>
          <Button Grid.Column="2" Content="Удалить выбранное" Command="{Binding DeleteSelectedContent}" IsEnabled="{Binding HasSelectedContent}" Margin="6,0"/>
          <Button Grid.Column="3" Content="Очистить всё" Command="{Binding DeleteAllContent}" Margin="6,0"/>
        </Grid>
        <Grid ColumnDefinitions="32,1.4*,1.2*,90,120,130" Margin="4,6,4,2">
          <TextBlock Grid.Column="1" Text="Сервер / форк" Classes="SubText"/><TextBlock Grid.Column="2" Text="Версия и движок" Classes="SubText"/>
          <TextBlock Grid.Column="3" Text="Размер" Classes="SubText"/><TextBlock Grid.Column="4" Text="Файлы" Classes="SubText"/><TextBlock Grid.Column="5" Text="Использовалось" Classes="SubText"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding ServerContent}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,1,0,0" Padding="4,9">
            <Grid ColumnDefinitions="32,1.4*,1.2*,90,120,130">
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding !InUse}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="{Binding ForkId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="ИСПОЛЬЗУЕТСЯ КЛИЕНТОМ" Classes="SubText" Foreground="#D6A84B" IsVisible="{Binding InUse}"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="{Binding ForkVersion}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Engine, StringFormat='Engine {0}'}" Classes="SubText"/></StackPanel>
              <TextBlock Grid.Column="3" Text="{Binding Size}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Files}" Classes="SubText" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="{Binding LastUsed}" Classes="SubText" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Classes="Surface" Padding="18"><StackPanel Spacing="10">
        <TextBlock Text="СРАВНЕНИЕ ИЗБРАННЫХ СЕРВЕРОВ" Classes="SectionLabel"/>
        <TextBlock Text="Выберите до трёх серверов для сравнения." Classes="SubText"/>
        <ItemsControl ItemsSource="{Binding FavoriteTools}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*" Margin="8,3"><CheckBox IsChecked="{Binding IsCompared, Mode=TwoWay}"/><TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <ItemsControl ItemsSource="{Binding ComparedServers}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" Padding="12" Margin="4"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Server.PingString, StringFormat='Пинг: {0}'}"/><TextBlock Text="{Binding Server.PlayerCountString}"/><TextBlock Text="{Binding Server.CacheData.Map, StringFormat='Карта: {0}'}"/><TextBlock Text="{Binding Server.CacheData.GamePreset, StringFormat='Режим: {0}'}"/><TextBlock Text="{Binding RoundTime}" Classes="SubText"/><Path Data="{Binding Server.PingGraph}" Stroke="#8A8A8A" StrokeThickness="1.2" Height="28" Stretch="Fill" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
