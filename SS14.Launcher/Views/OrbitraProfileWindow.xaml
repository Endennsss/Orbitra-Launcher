<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SS14.Launcher.Views"
        x:Class="SS14.Launcher.Views.OrbitraProfileWindow"
        Width="780" Height="680" MinWidth="620" MinHeight="520"
        Title="Профиль Orbitra" Icon="{DynamicResource WindowIcon}"
        WindowStartupLocation="CenterOwner" SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome">
  <Grid RowDefinitions="44,*" Background="{DynamicResource LauncherWorkspaceBrush}" ClipToBounds="True">
    <Border Background="{DynamicResource LauncherChromeBrush}" BorderBrush="{DynamicResource LauncherLineBrush}"
            BorderThickness="0,0,0,1" PointerPressed="TitleBarPressed">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0" VerticalAlignment="Center">
          <TextBlock Text="ORBITRA" FontSize="11" FontWeight="Bold" LetterSpacing="1.1"
                     Foreground="{DynamicResource ThemeSubTextBrush}"/>
          <TextBlock Text="/" Foreground="{DynamicResource ThemeSubTextBrush}"/>
          <TextBlock Text="{Binding FoundProfile.Username}" FontSize="11" FontWeight="Bold" LetterSpacing="1.1"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="WindowCommand" Width="46" Height="44" Padding="0" Margin="0" Click="MinimizeClicked">
            <Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button Classes="WindowCommand" Width="46" Height="44" Padding="0" Margin="0" Click="MaximizeClicked">
            <Rectangle Width="10" Height="9" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.2"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button Classes="WindowCommand Close" Width="46" Height="44" Padding="0" Margin="0" Click="CloseClicked">
            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(45deg)"/>
              <Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(-45deg)"/>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Classes="DialogContent" Margin="18" Spacing="10">
        <Border Classes="Surface MotionCard" ClipToBounds="True">
          <Grid RowDefinitions="174,Auto">
            <Border Background="{DynamicResource LauncherChromeBrush}">
              <Grid>
                <Image Source="{Binding FoundBanner}" Stretch="UniformToFill"/>
                <Border Height="68" VerticalAlignment="Bottom">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#00101010" Offset="0"/>
                      <GradientStop Color="#E6101010" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="118,*,Auto" Margin="20,0,20,18">
              <Grid Width="98" Height="98" Margin="0,-40,0,0" ZIndex="2">
                <Ellipse Fill="{DynamicResource LauncherSurfaceAltBrush}" Stroke="{DynamicResource LauncherLineBrush}" StrokeThickness="3"/>
                <TextBlock Text="{Binding FoundInitial}" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Stroke="{DynamicResource LauncherLineBrush}" StrokeThickness="3">
                  <Ellipse.Fill><ImageBrush Source="{Binding FoundAvatar}" Stretch="UniformToFill"/></Ellipse.Fill>
                </Ellipse>
              </Grid>

              <StackPanel Grid.Column="1" Margin="10,12,16,0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding FoundProfile.Username}" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/>
                  <local:CreatorBadge Width="23" Height="23" IsVisible="{Binding FoundProfileIsCreator}" VerticalAlignment="Center"/>
                  <Border Height="23" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1"
                          Padding="9,0" IsVisible="{Binding FoundIsOnline}" VerticalAlignment="Center">
                    <TextBlock Text="ОНЛАЙН" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}"
                               VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding FoundRelationshipText}" Classes="SubText"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,13,0,0" VerticalAlignment="Top">
                <Button Content="Принять заявку" Command="{Binding AcceptFoundFriend}" IsVisible="{Binding CanAcceptFoundFriend}"/>
                <Button Content="Добавить в друзья" Command="{Binding AddFoundFriend}" IsVisible="{Binding CanAddFoundFriend}"/>
                <Button Content="Подключиться" Command="{Binding ConnectFoundFriend}" IsVisible="{Binding FoundCanConnect}"/>
                <Button Content="Пригласить" Command="{Binding InviteFoundFriend}" IsVisible="{Binding FoundCanInvite}"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="1.35*,*" RowDefinitions="Auto" VerticalAlignment="Top">
          <Border Classes="Surface MotionCard" Padding="15" Margin="0,0,5,0" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <TextBlock Text="О ПОЛЬЗОВАТЕЛЕ" Classes="SectionLabel"/>
              <TextBlock Text="{Binding FoundDescriptionDisplay}" TextWrapping="Wrap" FontSize="14"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="Surface MotionCard" Padding="15" Margin="5,0,0,0" VerticalAlignment="Top">
            <StackPanel Spacing="9">
              <StackPanel Spacing="3">
                <TextBlock Text="АКТИВНОСТЬ" Classes="SectionLabel"/>
                <TextBlock Text="{Binding FoundActivityText}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Text="ЛЮБИМЫЙ СЕРВЕР" Classes="SectionLabel"/>
                <TextBlock Text="{Binding FoundFavoriteServerText}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="Surface MotionCard" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="ТЕМЫ ПОЛЬЗОВАТЕЛЯ" Classes="SectionLabel"/>
            <TextBlock Text="У пользователя пока нет опубликованных тем." Classes="SubText"
                       HorizontalAlignment="Center" Margin="0,18" IsVisible="{Binding !HasFoundThemes}"/>
            <ItemsControl Classes="MotionList" ItemsSource="{Binding FoundThemes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource LauncherSurfaceAltBrush}" BorderBrush="{DynamicResource LauncherLineBrush}"
                          BorderThickness="1" Padding="12" Margin="0,3">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding Description}" Classes="SubText" TextWrapping="Wrap" MaxLines="2"/>
                        <TextBlock Text="{Binding Meta}" Classes="SubText"/>
                      </StackPanel>
                      <Button Grid.Column="1" Content="Открыть" Command="{Binding Open}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
          <Button Content="{Binding FoundRemoveActionText}" Command="{Binding RemoveFoundFriend}"
                  IsVisible="{Binding CanRemoveFoundFriend}" HorizontalAlignment="Left"/>
          <Button Grid.Column="1" Content="Закрыть" Click="CloseClicked"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
