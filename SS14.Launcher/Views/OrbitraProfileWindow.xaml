<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SS14.Launcher.Views"
 x:Class="SS14.Launcher.Views.OrbitraProfileWindow" Width="720" Height="600" MinWidth="560" MinHeight="480"
 Title="Профиль Orbitra" Icon="{DynamicResource WindowIcon}" WindowStartupLocation="CenterOwner" SystemDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome">
 <Grid RowDefinitions="44,*" Background="{DynamicResource LauncherWorkspaceBrush}" ClipToBounds="True"><Border Background="{DynamicResource LauncherChromeBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,0,0,1" PointerPressed="TitleBarPressed"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="ORBITRA · ПРОФИЛЬ" VerticalAlignment="Center" Margin="14,0" FontSize="11" FontWeight="Bold" LetterSpacing="1.1" Foreground="{DynamicResource ThemeSubTextBrush}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="WindowCommand" Width="46" Height="44" Padding="0" Margin="0" Click="MinimizeClicked"><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button><Button Classes="WindowCommand" Width="46" Height="44" Padding="0" Margin="0" Click="MaximizeClicked"><Rectangle Width="10" Height="9" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.2"/></Button><Button Classes="WindowCommand Close" Width="46" Height="44" Padding="0" Margin="0" Click="CloseClicked"><Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(45deg)"/><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(-45deg)"/></Grid></Button></StackPanel></Grid></Border>
 <ScrollViewer Grid.Row="1"><StackPanel Margin="24" Spacing="14">
  <Border Classes="Surface" ClipToBounds="True"><Grid RowDefinitions="190,Auto">
   <Border Background="#242424"><Image Source="{Binding FoundBanner}" Stretch="UniformToFill"/></Border>
   <Grid Grid.Row="1" ColumnDefinitions="120,*" Margin="20,0,20,24"><Ellipse Width="104" Height="104" Margin="0,-46,0,0" Stroke="{DynamicResource LauncherLineBrush}" StrokeThickness="3" ZIndex="2"><Ellipse.Fill><ImageBrush Source="{Binding FoundAvatar}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
    <StackPanel Grid.Column="1" Margin="18,12,0,0" Spacing="9"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding FoundProfile.Username}" FontSize="27" FontWeight="Bold"/><local:CreatorBadge Width="25" Height="25" IsVisible="{Binding FoundProfileIsCreator}"/><TextBlock Text="{Binding FoundPresenceText}" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" IsVisible="{Binding FoundIsOnline}"/></StackPanel><StackPanel Spacing="3"><TextBlock Text="ОПИСАНИЕ" Classes="SectionLabel"/><TextBlock Text="{Binding FoundDescriptionDisplay}" TextWrapping="Wrap"/></StackPanel><TextBlock Text="{Binding FoundProfile.FavoriteServerName,StringFormat='Любимый сервер: {0}'}" Classes="SubText"/><TextBlock Text="{Binding FoundServerText}" Classes="SubText"/></StackPanel>
   </Grid>
  </Grid></Border>
  <Border Classes="Surface" Padding="18"><StackPanel Spacing="10"><TextBlock Text="ТЕМЫ ПОЛЬЗОВАТЕЛЯ" Classes="SectionLabel"/><ItemsControl ItemsSource="{Binding FoundThemes}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" Padding="12" Margin="0,3"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Classes="SubText" TextWrapping="Wrap"/><TextBlock Text="{Binding Meta}" Classes="SubText"/></StackPanel><Button Grid.Column="1" Content="Открыть" Command="{Binding Open}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  <Button Content="Добавить в друзья" Command="{Binding AddFoundFriend}" HorizontalAlignment="Left"/>
  <Button Content="Закрыть" HorizontalAlignment="Right" Click="CloseClicked"/>
 </StackPanel></ScrollViewer></Grid>
</Window>
