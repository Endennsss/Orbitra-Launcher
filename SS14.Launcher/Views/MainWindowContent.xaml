<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
             xmlns:v="clr-namespace:SS14.Launcher.Views"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SS14.Launcher.Views.MainWindowContent">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Panel Background="{DynamicResource ThemeStripeBackBrush}" ClipToBounds="True">
    <Image Source="{Binding ActiveThemeBackground}" Stretch="UniformToFill"
           IsVisible="{Binding CustomThemeTab.BackgroundVisible}" IsHitTestVisible="False">
      <Image.Effect><BlurEffect Radius="{Binding CustomThemeTab.Blur}" /></Image.Effect>
    </Image>
    <Image anim:ImageBehavior.AnimatedSource="{Binding ActiveAnimatedThemeBackground}"
           anim:ImageBehavior.RepeatBehavior="Forever" Stretch="UniformToFill"
           IsVisible="{Binding CustomThemeTab.BackgroundVisible}" IsHitTestVisible="False">
      <Image.Effect><BlurEffect Radius="{Binding CustomThemeTab.Blur}" /></Image.Effect>
    </Image>
    <Border Background="#000000" Opacity="{Binding CustomThemeTab.BackgroundDimmingOpacity}"
            IsVisible="{Binding CustomThemeTab.BackgroundVisible}" IsHitTestVisible="False" />
    <Border Classes="BackgroundScan" Height="180" VerticalAlignment="Top" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#00FFFFFF" />
          <GradientStop Offset="0.5" Color="#10FFFFFF" />
          <GradientStop Offset="1" Color="#00FFFFFF" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <DockPanel LastChildFill="true">
      <Grid>
        <!-- Main tabbed layout when logged in -->
        <Grid IsVisible="{Binding LoggedIn}" ColumnDefinitions="Auto,1,*">
          <Border Width="{Binding NavigationPanelWidth}" Background="{DynamicResource LauncherChromeBrush}" ClipToBounds="True">
          <Border.Transitions>
            <Transitions><DoubleTransition Property="Width" Duration="0:0:0.32" Easing="CubicEaseOut" /></Transitions>
          </Border.Transitions>
          <Grid RowDefinitions="62,*">
          <Panel Grid.Row="0">
            <Button Classes="NavCollapse" Width="210" Height="42" Margin="14,10,14,10" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Command="{Binding ToggleNavigationCompact}" ToolTip.Tip="{Binding NavigationToggleText}" IsVisible="{Binding !IsNavigationCompact}">
              <Grid ColumnDefinitions="4,30,*"><Viewbox Grid.Column="1" Width="19" Height="19"><Canvas Width="24" Height="24"><Path Classes="NavToggleIcon" Data="{Binding NavigationToggleIcon}" Fill="Transparent" Stroke="{DynamicResource ThemeSubTextBrush}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox><TextBlock Grid.Column="2" Text="Свернуть панель" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeSubTextBrush}"/></Grid>
            </Button>
            <Button Classes="NavCollapse" Width="46" Height="42" Margin="14,10,14,10" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ToggleNavigationCompact}" ToolTip.Tip="{Binding NavigationToggleText}" IsVisible="{Binding IsNavigationCompact}">
              <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Classes="NavToggleIcon" Data="{Binding NavigationToggleIcon}" Fill="Transparent" Stroke="{DynamicResource ThemeSubTextBrush}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
            </Button>
          </Panel>
          <ListBox ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedIndex,Mode=TwoWay}"
                   Grid.Row="1"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Background="Transparent" BorderThickness="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Width="{Binding $parent[UserControl].DataContext.NavigationItemsWidth}" Spacing="6" Margin="14,8,14,18">
                <StackPanel.Transitions>
                  <Transitions><DoubleTransition Property="Width" Duration="0:0:0.32" Easing="CubicEaseOut" /></Transitions>
                </StackPanel.Transitions>
              </StackPanel>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="mainWindowTabs:MainWindowTabViewModel">
              <Grid ColumnDefinitions="4,30,*,Auto" Height="48" Margin="0" ToolTip.Tip="{Binding Name}">
                <Border Classes="NavIndicator" Width="3" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource ThemeAccentBrush}" Opacity="0" />
                <Viewbox Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center"
                         Stretch="Uniform" ClipToBounds="False"
                         Margin="{Binding $parent[UserControl].DataContext.NavigationIconMargin}">
                  <Canvas Width="24" Height="24" ClipToBounds="False">
                    <Path Classes="NavIcon" Data="{Binding IconData}" Fill="Transparent"
                          Stroke="{DynamicResource ThemeSubTextBrush}" StrokeThickness="1.8"
                          StrokeLineCap="Round" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="2" Classes="NavText" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,4,0"
                           Foreground="{DynamicResource ThemeSubTextBrush}"
                           IsVisible="{Binding !$parent[UserControl].DataContext.IsNavigationCompact}" />
                <Panel Grid.Column="3" IsVisible="{Binding !$parent[UserControl].DataContext.IsNavigationCompact}">
                  <Border IsVisible="{Binding HasBadge}" Background="{DynamicResource LauncherControlBrush}"
                          BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" MinWidth="24" Height="22"
                          Padding="6,0" Margin="4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BadgeText}" FontSize="10" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}" />
                  </Border>
                </Panel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          </ListBox>
          </Grid>
          </Border>
          <Border Grid.Column="1" Background="{DynamicResource ThemeStripebackEdgeBrush}"/>
          <ContentControl Grid.Column="2" Content="{Binding SelectedTab}" Margin="22" ClipToBounds="True"><ContentControl.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.22"/></Transitions></ContentControl.Transitions></ContentControl>
        </Grid>
        <!-- Login interface when not logged in -->
        <v:MainWindowLogin
          IsVisible="{Binding !$parent.DataContext.LoggedIn}"
          DataContext="{Binding LoginViewModel}" />
      </Grid>
    </DockPanel>

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding LoginViewModel.Screen.OverlayControl, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding LoginViewModel.Screen.OverlayControl}" />
    </ContentControl>

    <ContentControl Classes="OverlayBox" IsVisible="{Binding LoginViewModel.Screen.Busy}">
      <StackPanel Orientation="Vertical" VerticalAlignment="Center">
        <Viewbox Classes="DungSpinnerBox">
          <!-- Explicitly setting visible to block animations -->
          <v:DungSpinner IsVisible="{Binding LoginViewModel.Screen.Busy}" />
        </Viewbox>
        <TextBlock Text="{Binding LoginViewModel.Screen.BusyText}" HorizontalAlignment="Center" />
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding OverlayViewModel, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding OverlayViewModel}" />
    </ContentControl>

    <ContentControl Classes="OverlayBox" IsVisible="{Binding BusyTask,Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Orientation="Vertical">
        <Viewbox Classes="DungSpinnerBox">
          <!-- Explicitly setting visible to block animations -->
          <v:DungSpinner DockPanel.Dock="Top" IsVisible="{Binding BusyTask,Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Viewbox>
        <TextBlock Text="{Binding BusyTask}" HorizontalAlignment="Center" />
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox" IsVisible="{Binding OutOfDate}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center" Classes="NanoHeadingMedium" Text="{loc:Loc main-window-out-of-date}" />
        <TextBlock Margin="0, 10" TextAlignment="Center"
                   Text="{loc:Loc main-window-out-of-date-desc}" />
        <DockPanel LastChildFill="False">
          <Button DockPanel.Dock="Right" Content="{loc:Loc main-window-out-of-date-exit}"
                  Command="{Binding ExitPressed}" />
          <Button DockPanel.Dock="Left" Content="{loc:Loc main-window-out-of-date-download-manual}"
                  Command="{Binding DownloadPressed}" />
        </DockPanel>
      </StackPanel>
    </ContentControl>

    <!-- Yes I realize the absurdity of having literally 5 of these error overlay controls defined get off my back. -->

    <ContentControl Classes="OverlayBox" IsVisible="{Binding !HasDismissedEarlyAccessWarning.Value}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center" Classes="NanoHeadingMedium"
                   Text="{loc:Loc main-window-early-access-title}" />
        <TextBlock Margin="0, 10" TextAlignment="Center" MaxWidth="450" TextWrapping="Wrap"
                   Text="{loc:Loc main-window-early-access-desc}" />
        <Button Content="{loc:Loc main-window-early-access-accept}" Command="{Binding DismissEarlyAccessPressed}"
                HorizontalAlignment="Center" />
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox" IsVisible="{Binding ShouldShowIntelDegradationWarning}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center" Classes="NanoHeadingMedium"
                   Text="{loc:Loc main-window-intel-degrade-title}" />
        <TextBlock Margin="0, 10" TextAlignment="Center" MaxWidth="450" TextWrapping="Wrap"
                   Text="{loc:Loc main-window-intel-degrade-desc}" />
        <Button Content="{loc:Loc main-window-intel-degrade-accept}" Command="{Binding DismissIntelDegradationPressed}"
                HorizontalAlignment="Center" />
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox" IsVisible="{Binding ShouldShowRosettaWarning}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center" Classes="NanoHeadingMedium"
                   Text="{loc:Loc main-window-rosetta-title}" />
        <TextBlock Margin="0, 10" TextAlignment="Center" MaxWidth="450" TextWrapping="Wrap"
                   Text="{loc:Loc main-window-rosetta-desc}" />
        <Button Content="{loc:Loc main-window-rosetta-accept}" Command="{Binding DismissAppleSiliconRosettaPressed}"
                HorizontalAlignment="Center" />
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox" IsVisible="{Binding ShouldShowAuthOverrideWarning}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center" Classes="NanoHeadingMedium" Foreground="Red"
                   Text="{loc:Loc main-window-auth-override-title}" />
        <TextBlock Margin="0, 10" TextAlignment="Center" MaxWidth="450" TextWrapping="Wrap"
                   Text="{loc:Loc main-window-auth-override-desc}" />
        <Button Content="{Binding AuthOverrideCountdown, StringFormat='I acknowledge ({0}s)'}"
                Command="{Binding DismissAuthOverridePressed}"
                IsEnabled="{Binding IsAuthOverrideButtonEnabled}"
                HorizontalAlignment="Center" />
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox" IsVisible="{Binding CustomUpdateAvailable}">
      <Border Width="520" Padding="24" Background="{DynamicResource LauncherSurfaceBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="ДОСТУПНО ОБНОВЛЕНИЕ" Classes="SectionLabel" />
          <TextBlock Text="{Binding CustomUpdateVersion, StringFormat='Новая версия: {0}'}" Classes="NanoHeadingMedium" />
          <TextBlock Text="Orbitra скачает архив, проверит SHA-256 и заменит файлы после закрытия лаунчера."
                     Classes="SubText" TextWrapping="Wrap" />
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding CustomUpdateProgress}" Height="5"
                       IsVisible="{Binding CustomUpdateInstalling}" />
          <TextBlock Text="{Binding CustomUpdateStatus}" Classes="SubText"
                     IsVisible="{Binding CustomUpdateInstalling}" TextWrapping="Wrap" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Content="Позже" Command="{Binding DismissCustomUpdate}" IsEnabled="{Binding !CustomUpdateInstalling}" />
            <Button Content="Открыть релиз" Command="{Binding OpenCustomUpdate}" />
            <Button Content="Скачать и установить" Command="{Binding InstallCustomUpdate}"
                    IsEnabled="{Binding !CustomUpdateInstalling}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </ContentControl>

    <Border Background="{DynamicResource LauncherWorkspaceBrush}" Opacity="{Binding CustomThemeTab.ThemeTransitionOpacity}"
            IsHitTestVisible="False">
      <Border.Transitions>
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.28" /></Transitions>
      </Border.Transitions>
    </Border>

    <ContentControl Classes="OverlayBox" IsVisible="{Binding ShowFirstRun}">
      <Border Background="{DynamicResource LauncherSurfaceBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" Padding="28" Width="560">
        <StackPanel Spacing="14">
          <StackPanel>
            <TextBlock Text="ДОБРО ПОЖАЛОВАТЬ" Classes="SectionLabel" />
            <TextBlock Text="Первичная настройка лаунчера" Classes="NanoHeadingMedium" />
            <TextBlock Text="Выберите основные параметры. Их всегда можно изменить в настройках."
                       Classes="SubText" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="Аккаунт" VerticalAlignment="Center" />
            <v:AccountDropDown Grid.Column="1" Height="42" DataContext="{Binding AccountDropDown}" />
            <TextBlock Grid.Row="1" Text="Язык" VerticalAlignment="Center" Margin="0,10,0,0" />
            <v:LanguageSelector Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" DataContext="{Binding OptionsTab.Language}"
                                Placement="BottomEdgeAlignedLeft" />
            <TextBlock Grid.Row="2" Text="Шрифт" VerticalAlignment="Center" Margin="0,10,0,0" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" ItemsSource="{Binding OptionsTab.AvailableFonts}"
                      SelectedItem="{Binding OptionsTab.SelectedFont, Mode=TwoWay}" />
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,0">
              <CheckBox Content="Автоматически обновлять пинг избранного"
                        IsChecked="{Binding OptionsTab.AutoRefreshFavoritePing, Mode=TwoWay}" />
              <CheckBox Content="Включить Discord Rich Presence"
                        IsChecked="{Binding OptionsTab.DiscordRpcEnabled, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
          <Button Content="НАЧАТЬ" Command="{Binding CompleteFirstRun}" HorizontalAlignment="Right" MinWidth="140" />
        </StackPanel>
      </Border>
    </ContentControl>

    <ContentControl Classes="OverlayBox" IsVisible="{Binding CommandPaletteOpen}">
      <Border Width="620" MaxHeight="480" Padding="18" Background="{DynamicResource LauncherSurfaceBrush}"
              BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" VerticalAlignment="Center">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="КОМАНДНАЯ ПАЛИТРА · CTRL+SHIFT+P" Classes="SectionLabel" />
            <TextBox Text="{Binding CommandPaletteQuery, Mode=TwoWay}" Watermark="Введите действие…" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding FilteredCommandPaletteItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CommandPaletteItem">
                  <Button Content="{Binding Title}" Command="{Binding Invoke}" HorizontalContentAlignment="Left" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </ContentControl>

    <!--
      Literally just keep piling them on it doesn't matter.
      This is way easier than coming up with some horribly over-engineered solution.
      -->

    <v:ConnectingOverlay DataContext="{Binding ConnectingVM}"
                         IsVisible="{Binding $parent.DataContext.ConnectingVM, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- Toasts live below the workspace actions: top-right is reserved for Refresh/Add buttons. -->
    <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,18,32" IsHitTestVisible="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="LauncherToast" Classes.Error="{Binding IsError}" Margin="0,0,0,8"
                  Padding="13,9" MinWidth="220" MaxWidth="320">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <v:AngleBox HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

    <ContentControl Classes="OverlayBox" Name="DragDropOverlay" IsVisible="False">
      <TextBlock Text="{loc:Loc main-window-drag-drop-prompt}" />
    </ContentControl>

    <TextBlock Text="{Binding Version}" HorizontalAlignment="Right"
               VerticalAlignment="Bottom" Classes="SubText" Margin="6"/>
  </Panel>
</UserControl>
