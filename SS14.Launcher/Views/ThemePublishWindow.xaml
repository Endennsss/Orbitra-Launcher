<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs" x:Class="SS14.Launcher.Views.ThemePublishWindow" Width="820" Height="700" MinWidth="680" MinHeight="560" Title="Публикация темы Orbitra" Icon="{DynamicResource WindowIcon}" WindowStartupLocation="CenterOwner" SystemDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome">
 <Grid RowDefinitions="44,*" Background="{DynamicResource LauncherWorkspaceBrush}" ClipToBounds="True">
  <Border Background="{DynamicResource LauncherChromeBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,0,0,1" PointerPressed="TitleBarPressed"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="ORBITRA · ПУБЛИКАЦИЯ ТЕМЫ" VerticalAlignment="Center" Margin="14,0" FontSize="11" FontWeight="Bold" LetterSpacing="1.1" Foreground="{DynamicResource ThemeSubTextBrush}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="WindowCommand" Width="46" Height="44" Padding="0" Margin="0" Click="MinimizeClicked"><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button><Button Classes="WindowCommand" Width="46" Height="44" Padding="0" Margin="0" Click="MaximizeClicked"><Rectangle Width="10" Height="9" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.2"/></Button><Button Classes="WindowCommand Close" Width="46" Height="44" Padding="0" Margin="0" Click="CloseClicked"><Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(45deg)"/><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(-45deg)"/></Grid></Button></StackPanel></Grid></Border>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24" Spacing="16">
   <StackPanel><TextBlock Text="WORKSHOP PUBLISHER" Classes="SectionLabel"/><TextBlock Text="{Binding PublishPanelTitle}" Classes="NanoHeadingMedium"/><TextBlock Text="Заполните карточку темы перед публикацией." Classes="SubText"/></StackPanel>
   <Border Classes="Surface" Padding="18"><StackPanel Spacing="10"><TextBlock Text="ОСНОВНАЯ ИНФОРМАЦИЯ" Classes="SectionLabel"/><TextBox Text="{Binding PublishName,Mode=TwoWay}" Watermark="Название темы" MaxLength="60"/><TextBox Text="{Binding PublishDescription,Mode=TwoWay}" Watermark="Подробное описание темы" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxLength="2000"/></StackPanel></Border>
   <Grid ColumnDefinitions="220,*"><Border Classes="Surface" Padding="16" Margin="0,0,6,0"><StackPanel Spacing="10"><TextBlock Text="ИКОНКА" Classes="SectionLabel"/><Border Width="128" Height="128" Background="{DynamicResource LauncherSurfaceAltBrush}" HorizontalAlignment="Center" ClipToBounds="True"><Image Source="{Binding PublishIcon}" Stretch="UniformToFill"/></Border><Button Content="Выбрать иконку" Command="{Binding ChoosePublishIcon}"/></StackPanel></Border><Border Grid.Column="1" Classes="Surface" Padding="16" Margin="6,0,0,0"><StackPanel Spacing="10"><TextBlock Text="СКРИНШОТЫ" Classes="SectionLabel"/><TextBlock Text="До четырёх изображений. Первый скриншот используется как обложка." Classes="SubText" TextWrapping="Wrap"/><Button Content="Выбрать скриншоты" Command="{Binding ChoosePublishScreenshots}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding PublishScreenshots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PublishScreenshotItem"><Border Width="128" Height="76" Margin="0,0,8,8" Background="{DynamicResource LauncherSurfaceAltBrush}" ClipToBounds="True" ToolTip.Tip="{Binding Name}"><Image Source="{Binding Bitmap}" Stretch="UniformToFill"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid>
   <TextBlock Text="Автором будет указан активный аккаунт Space Station 14." Classes="SubText"/>
   <Grid ColumnDefinitions="*,Auto,Auto"><ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding WorkshopBusy}"/><Button Grid.Column="1" Content="Отмена" Command="{Binding CancelWorkshopEdit}" Click="CloseClicked"/><Button Grid.Column="2" Content="{Binding PublishActionText}" Command="{Binding PublishToWorkshop}" IsEnabled="{Binding !WorkshopBusy}" Margin="8,0,0,0"/></Grid>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
