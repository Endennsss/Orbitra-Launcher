<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="SS14.Launcher.Views.ImageCropWindow" Width="820" Height="650" MinWidth="700" MinHeight="560"
 Title="Редактор изображения" Icon="{DynamicResource WindowIcon}" WindowStartupLocation="CenterOwner" SystemDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome">
 <Grid RowDefinitions="44,*" Background="{DynamicResource LauncherWorkspaceBrush}" ClipToBounds="True">
  <Border Background="{DynamicResource LauncherChromeBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="0,0,0,1" PointerPressed="TitleBarPressed"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0" Spacing="10"><TextBlock Text="ORBITRA · РЕДАКТОР ИЗОБРАЖЕНИЯ" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" LetterSpacing="1.1" Foreground="{DynamicResource ThemeSubTextBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="WindowCommand" Width="46" Height="44" Padding="0" Margin="0" Click="MinimizeClicked"><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button><Button Classes="WindowCommand" Width="46" Height="44" Padding="0" Margin="0" Click="MaximizeClicked"><Rectangle Width="10" Height="9" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.2"/></Button><Button Classes="WindowCommand Close" Width="46" Height="44" Padding="0" Margin="0" Click="CloseWindowClicked"><Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(45deg)"/><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(-45deg)"/></Grid></Button></StackPanel></Grid></Border>
 <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="20">
  <StackPanel><TextBlock Text="НАСТРОЙКА ИЗОБРАЖЕНИЯ" Classes="SectionLabel"/><TextBlock x:Name="EditorTitle" Text="Обрежьте изображение" Classes="NanoHeadingMedium"/></StackPanel>
  <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="0,18">
   <Border x:Name="CropHost" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Background="#181818" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1">
    <Image x:Name="CropImage" Stretch="Fill" RenderTransformOrigin="50%,50%"/>
   </Border>
   <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="130,*,60" Margin="50,18,50,0">
    <TextBlock Text="Приближение" VerticalAlignment="Center"/><Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="1" Maximum="6" Value="1" Margin="10,5"/><TextBlock x:Name="ZoomValueText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
    <TextBlock Grid.Row="1" Text="По горизонтали" VerticalAlignment="Center"/><Slider x:Name="XSlider" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Minimum="-180" Maximum="180" Value="0" Margin="10,5"/>
    <TextBlock Grid.Row="2" Text="По вертикали" VerticalAlignment="Center"/><Slider x:Name="YSlider" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Minimum="-180" Maximum="180" Value="0" Margin="10,5"/>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Сбросить" Click="ResetClicked"/><Button Content="Отмена" Click="CancelClicked"/><Button Content="Применить" Click="ApplyClicked"/></StackPanel>
 </Grid></Grid>
</Window>
