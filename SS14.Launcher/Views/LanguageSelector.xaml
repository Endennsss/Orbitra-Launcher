<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
             xmlns:v="clr-namespace:SS14.Launcher.Views"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SS14.Launcher.Views.LanguageSelector">
  <Design.DataContext>
    <vm:LanguageSelectorViewModel />
  </Design.DataContext>

  <v:DropDown IsDropDownOpen="{Binding IsDropDownOpen, Mode=TwoWay}" Name="DropDown"
              Width="260" MinWidth="260" Height="44"
              Placement="TopEdgeAlignedLeft">
    <v:DropDown.HeaderContent>
      <Grid ColumnDefinitions="24,*" Margin="0" VerticalAlignment="Center">
        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M2,10 L18,10 M10,2 C6,6 6,14 10,18 M10,2 C14,6 14,14 10,18"
                Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.2" />
        </Viewbox>
        <TextBlock Grid.Column="1" Text="{loc:Loc language-selector-label}" Margin="8,0,16,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </v:DropDown.HeaderContent>
    <Panel Width="400" Height="300">
      <v:AngleBox Fill="{DynamicResource ThemePopupBackgroundBrush}" SideStyle="OpenLeft" />
      <DockPanel>
        <!-- Bottom row -->
        <Grid DockPanel.Dock="Bottom" Margin="2" ColumnDefinitions="*,*" RowDefinitions="*,Auto">
          <Button Grid.Column="0" Grid.Row="0" Classes="OpenBoth" IsEnabled="{Binding IsChangeSelected}"
                  Command="{Binding OnSaveButtonPressed}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="M1,6 L5,10 L13,1" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="2" Width="14" Height="12" />
              <TextBlock Text="{loc:Loc language-selector-save}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Grid.Row="0" Classes="OpenLeft" IsEnabled="{Binding IsChangeSelected}"
                  Command="{Binding OnCancelButtonPressed}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.8" Width="12" Height="12" />
              <TextBlock Text="{loc:Loc language-selector-cancel}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Classes="OpenRight"
                  Content="{loc:Loc language-selector-help-translate}"
                  Command="{Binding OnHelpTranslateButtonPressed}" />
        </Grid>
        <!-- Main contents -->
        <ScrollViewer Margin="2">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Languages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageSelectorLanguageViewModel">
                  <RadioButton GroupName="Language" Content="{Binding Text}"
                               IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Panel>
  </v:DropDown>
</UserControl>
