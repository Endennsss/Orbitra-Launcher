<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
        x:Class="SS14.Launcher.Views.ThemeWorkshopWindow"
        Title="Мастерская тем Orbitra"
        Icon="{DynamicResource WindowIcon}"
        Width="1000" Height="720" MinWidth="820" MinHeight="560"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
  <Grid RowDefinitions="44,*" Background="{DynamicResource LauncherWorkspaceBrush}" ClipToBounds="True">
    <Border Background="{DynamicResource LauncherChromeBrush}" BorderBrush="{DynamicResource LauncherLineBrush}"
            BorderThickness="0,0,0,1" PointerPressed="TitleBarPressed">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0" Spacing="10">
          <Path Width="20" Height="20" Stretch="Uniform"
                Data="M3,9 L4,4 L20,4 L21,9 M5,13 L5,21 L19,21 L19,13 M9,21 L9,15 L15,15 L15,21"
                Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.7" StrokeLineCap="Round" />
          <TextBlock Text="ORBITRA · МАСТЕРСКАЯ ТЕМ" VerticalAlignment="Center" FontSize="11"
                     FontWeight="Bold" LetterSpacing="1.1" Foreground="{DynamicResource ThemeSubTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="WindowCommand" Width="46" Height="44" Padding="0" Margin="0" Click="MinimizeClicked">
            <Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Classes="WindowCommand Close" Width="46" Height="44" Padding="0" Margin="0" Click="CloseClicked">
            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(45deg)"/><Rectangle Width="11" Height="1.5" Fill="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" RenderTransform="rotate(-45deg)"/></Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24" Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="COMMUNITY WORKSHOP" Classes="SectionLabel" />
            <TextBlock Text="Темы сообщества Orbitra" Classes="NanoHeadingMedium" />
            <TextBlock Text="Публикуйте оформление, устанавливайте темы, ставьте лайки и оставляйте комментарии."
                       Classes="SubText" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Опубликовать тему" Command="{Binding OpenPublishWindow}"/><Button Content="Обновить" Command="{Binding RefreshWorkshop}" /></StackPanel>
        </Grid>

        <Border Background="#2A2417" BorderBrush="#6E5B30" BorderThickness="1" Padding="14"
                IsVisible="{Binding IsWorkshopPreviewActive}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{Binding WorkshopPreviewText}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="Оставить тему" Command="{Binding KeepWorkshopPreview}" />
            <Button Grid.Column="2" Content="Вернуть предыдущую" Command="{Binding RevertWorkshopPreview}" />
          </Grid>
        </Border>

        <Border Background="#2A1818" BorderBrush="#713737" BorderThickness="1" Padding="14"
                IsVisible="{Binding IsWorkshopDeleteConfirmationVisible}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{Binding WorkshopDeleteConfirmationText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Удалить" Command="{Binding ConfirmDeleteWorkshopTheme}" />
            <Button Grid.Column="2" Content="Отмена" Command="{Binding CancelDeleteWorkshopTheme}" />
          </Grid>
        </Border>

        <TextBlock Text="{Binding WorkshopStatus}" Classes="SubText" />
        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding WorkshopBusy}" />

        <Grid ColumnDefinitions="*,210,Auto" IsVisible="{Binding !HasSelectedWorkshopTheme}">
          <TextBox Text="{Binding WorkshopSearch, Mode=TwoWay}" Watermark="Поиск по названию или автору" />
          <ComboBox Grid.Column="1" SelectedIndex="{Binding WorkshopSortIndex, Mode=TwoWay}" Margin="8,0">
            <ComboBoxItem Content="Сначала новые" />
            <ComboBoxItem Content="По лайкам" />
            <ComboBoxItem Content="По загрузкам" />
            <ComboBoxItem Content="По названию" />
          </ComboBox>
          <CheckBox Grid.Column="2" Content="Только избранные" IsChecked="{Binding WorkshopFavoritesOnly, Mode=TwoWay}"
                    VerticalAlignment="Center" />
        </Grid>

        <ItemsControl ItemsSource="{Binding WorkshopThemes}" IsVisible="{Binding !HasSelectedWorkshopTheme}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkshopThemeItemViewModel">
              <Border Classes="Surface" Padding="16" Margin="0,0,0,8">
                <Grid ColumnDefinitions="210,*,Auto">
                  <Border Background="{DynamicResource LauncherSurfaceAltBrush}" Height="118" ClipToBounds="True">
                    <Grid>
                      <Image Source="{Binding PreviewBitmap}" Stretch="UniformToFill" />
                      <Border Width="7" HorizontalAlignment="Left" Background="{Binding Theme.Accent}" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0" Spacing="5">
                    <WrapPanel>
                      <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Version}" Classes="SubText" Margin="10,4,0,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{Binding Author}" Classes="SubText" />
                    <TextBlock Text="{Binding Stats}" Classes="SubText" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6" Width="145">
                    <Button Content="{Binding InstallText}" Command="{Binding Install}" IsEnabled="{Binding CanInstall}" />
                    <Button Content="Предпросмотр" Command="{Binding Preview}" />
                    <Button Content="{Binding LikeText}" Command="{Binding ToggleLike}" />
                    <Button Content="{Binding FavoriteText}" Command="{Binding ToggleFavorite}" />
                    <Button Content="Подробнее" Command="{Binding Open}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="Surface" Padding="18" IsVisible="{Binding HasSelectedWorkshopTheme}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding SelectedWorkshopTheme.Name}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedWorkshopTheme.Author}" Classes="SubText" />
              </StackPanel>
              <Button Grid.Column="1" Content="Назад к темам" Command="{Binding CloseWorkshopTheme}" />
            </Grid>
            <Border Height="260" Background="{DynamicResource LauncherSurfaceAltBrush}" ClipToBounds="True">
              <Image Source="{Binding SelectedWorkshopTheme.PreviewBitmap}" Stretch="UniformToFill" />
            </Border>
            <TextBlock Text="{Binding SelectedWorkshopTheme.Description}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedWorkshopTheme.Palette}" Classes="SubText" FontFamily="Consolas" />
            <WrapPanel>
              <Button Content="{Binding SelectedWorkshopTheme.InstallText}" Command="{Binding SelectedWorkshopTheme.Install}"
                      IsEnabled="{Binding SelectedWorkshopTheme.CanInstall}" />
              <Button Content="Предпросмотр" Command="{Binding SelectedWorkshopTheme.Preview}" />
              <Button Content="{Binding SelectedWorkshopTheme.LikeText}" Command="{Binding SelectedWorkshopTheme.ToggleLike}" />
              <Button Content="{Binding SelectedWorkshopTheme.FavoriteText}" Command="{Binding SelectedWorkshopTheme.ToggleFavorite}" />
              <Button Content="Редактировать публикацию" Command="{Binding SelectedWorkshopTheme.Update}"
                      IsVisible="{Binding SelectedWorkshopTheme.IsOwn}" />
              <Button Content="Удалить публикацию" Command="{Binding SelectedWorkshopTheme.Delete}"
                      IsVisible="{Binding SelectedWorkshopTheme.IsOwn}" />
            </WrapPanel>
            <TextBlock Text="КОММЕНТАРИИ" Classes="SectionLabel" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding WorkshopComments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkshopCommentItemViewModel">
                  <Border Background="{DynamicResource LauncherSurfaceAltBrush}" Padding="11" Margin="0,0,0,6">
                    <StackPanel>
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Date}" Classes="SubText" />
                        <Button Grid.Column="2" Content="Удалить" Command="{Binding Delete}" IsVisible="{Binding IsOwn}"
                                Margin="8,0,0,0" Padding="8,2" />
                      </Grid>
                      <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding NewComment, Mode=TwoWay}" Watermark="Комментарий от активного аккаунта SS14"
                       MaxLength="1000" />
              <Button Grid.Column="1" Content="Отправить" Command="{Binding AddWorkshopComment}" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
