<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
             xmlns:views="clr-namespace:SS14.Launcher.Views"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="100"
             x:Class="SS14.Launcher.Views.ConnectingOverlay">

  <Design.DataContext>
    <vm:ConnectingViewModel />
  </Design.DataContext>
  <Grid>
    <!-- Compact non-blocking connection dock. -->
    <Border Classes="ConnectionDock" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
            Margin="18" Padding="16,12" IsVisible="{Binding !IsAskingPrivacyPolicy}"
            Background="{DynamicResource LauncherSurfaceBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1"
            BoxShadow="0 10 32 #B0000000">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <Viewbox Classes="DockSpinner" Grid.RowSpan="2" Width="26" Height="26" Stretch="Uniform"
                 ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,14,0">
          <Canvas Width="24" Height="24">
            <Path Data="M21,12 A9,9 0 1 1 14.781,3.44"
                  Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="2" StrokeLineCap="Round" />
          </Canvas>
        </Viewbox>

        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Classes="SubText"
                     Margin="14,0,0,0" VerticalAlignment="Center"
                     IsVisible="{Binding !SpeedIndeterminate}" />
          <TextBlock Grid.Column="2" Text="{Binding ProgressText}" Classes="SubText"
                     Margin="14,0,0,0" VerticalAlignment="Center"
                     IsVisible="{Binding !ProgressIndeterminate}" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,7,0,0">
          <ProgressBar Maximum="1" Value="{Binding Progress}"
                       IsIndeterminate="{Binding ProgressIndeterminate}"
                       IsVisible="{Binding ProgressBarVisible}" Height="5" />
          <TextBlock Text="Ожидание запуска клиента…" Classes="SubText" FontSize="10"
                     IsVisible="{Binding !ProgressBarVisible}" />
        </Grid>

        <Button Grid.Column="2" Grid.RowSpan="2" Name="CancelButton" MinWidth="92" Margin="14,0,0,0"
                Content="{loc:Loc connecting-cancel}" Command="{Binding Cancel}"
                IsVisible="{Binding !IsErrored}" />
        <Button Grid.Column="2" Grid.RowSpan="2" MinWidth="92" Margin="14,0,0,0"
                Content="OK" Command="{Binding ErrorDismissed}" IsVisible="{Binding IsErrored}" />

        <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="0,9,0,0"
                Padding="0" Background="Transparent" BorderThickness="0"
                Content="{Binding DiagnosticSummary}" Command="{Binding ToggleDiagnostics}"
                Classes="TextButton" />

        <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,9,0,0" Padding="12"
                IsVisible="{Binding DiagnosticsVisible}"
                Background="{DynamicResource LauncherWorkspaceBrush}"
                BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <ItemsControl ItemsSource="{Binding Diagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="22,150,*" Margin="0,3">
                    <TextBlock Text="{Binding Marker}" Foreground="{Binding Color}" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding Details}" Classes="SubText"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ErrorDetails}" Classes="SubText" TextWrapping="Wrap"
                       IsVisible="{Binding IsErrored}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsErrored}">
              <Button Content="Исправить и повторить" Command="{Binding RepairAndRetry}" />
              <Button Content="Открыть журналы" Command="{Binding OpenLogs}" />
              <Button Content="Закрыть" Command="{Binding ErrorDismissed}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Privacy policy still requires a blocking decision. -->
    <ContentControl Classes="OverlayBox" IsVisible="{Binding IsAskingPrivacyPolicy}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center" Classes="NanoHeadingMedium" Text="{Binding TitleText}" />
        <TextBlock HorizontalAlignment="Center" Margin="0 10" DockPanel.Dock="Top" Text="{Binding PrivacyPolicyText}"
                   TextWrapping="Wrap" MaxWidth="400" />

        <Button Content="{loc:Loc 'connecting-privacy-policy-view'}" Command="{Binding PrivacyPolicyView}"
                HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10">
          <Button Content="{loc:Loc 'connecting-privacy-policy-accept'}" Command="{Binding PrivacyPolicyAccept}"
                  Classes="OpenRight" />
          <Button Content="{loc:Loc 'connecting-privacy-policy-decline'}" Command="{Binding PrivacyPolicyDeny}"
                  Classes="OpenLeft"/>
        </StackPanel>
      </StackPanel>
    </ContentControl>
  </Grid>
</UserControl>
