<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vml="clr-namespace:SS14.Launcher.ViewModels.Login;assembly=SS14.Launcher"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             xmlns:local="clr-namespace:SS14.Launcher"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
             x:Class="SS14.Launcher.Views.Login.LoginView" Name="Login">
  <Design.DataContext><vml:LoginViewModel /></Design.DataContext>

  <UserControl.Styles>
    <Style Selector="TextBox.AuthInput">
      <Setter Property="Height" Value="48" /><Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.18"/><BrushTransition Property="Background" Duration="0:0:0.18"/></Transitions></Setter>
    </Style>
    <Style Selector="Button.AuthPrimary">
      <Setter Property="Height" Value="48" /><Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="15" />
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18"/><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/></Transitions></Setter>
    </Style>
    <Style Selector="Button.AuthPrimary:pointerover"><Setter Property="RenderTransform" Value="scale(1.012)" /></Style>
    <Style Selector="Button.AuthLink"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4,7"/><Setter Property="Foreground" Value="{DynamicResource ThemeSubTextBrush}"/></Style>
    <Style Selector="Button.AuthLink:pointerover /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/><Setter Property="Background" Value="Transparent"/></Style>
  </UserControl.Styles>

  <StackPanel Spacing="0">
    <TextBlock Text="{loc:Loc login-orbitra-secure-access}" FontSize="10" FontWeight="Bold" LetterSpacing="1.8"
               Foreground="{DynamicResource ThemeSubTextBrush}" />
    <TextBlock Margin="0,8,0,0" Classes="NanoHeadingMedium" FontSize="28"
               Text="{loc:Loc login-login-title}" />
    <TextBlock Margin="0,8,0,20" Text="{loc:Loc login-orbitra-subtitle}"
               TextWrapping="Wrap" Foreground="{DynamicResource ThemeSubTextBrush}" FontSize="14" />

    <Border Padding="12" Margin="0,0,0,16" Background="#2A160F" BorderBrush="#6E3828" BorderThickness="1"
            IsVisible="{Binding Source={x:Static local:ConfigConstants.IsAuthOverride}}">
      <TextBlock Foreground="#E6A083" TextWrapping="Wrap" Text="{loc:Loc login-login-auth-server-changed}" />
    </Border>

    <TextBlock Text="{loc:Loc login-orbitra-identity}" Classes="NanoHeadingSmall" Margin="0,0,0,7" />
    <TextBox Classes="AuthInput" Name="NameBox" Watermark="{loc:Loc login-login-username-watermark}"
             Text="{Binding Username}" IsEnabled="{Binding !Busy}" />

    <Grid ColumnDefinitions="*,Auto" Margin="0,17,0,7">
      <TextBlock Text="{loc:Loc login-orbitra-password}" Classes="NanoHeadingSmall" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="AuthLink" Content="{loc:Loc login-login-button-forgot}"
              Command="{Binding ParentVM.SwitchToForgotPassword}" IsEnabled="{Binding !Busy}" />
    </Grid>
    <TextBox Classes="AuthInput" Name="PasswordBox" Watermark="{loc:Loc login-login-password-watermark}"
             Text="{Binding Password}" PasswordChar="•" IsEnabled="{Binding !Busy}" />
    <CheckBox Margin="2,10,0,16" Name="ShowPassword" IsCheckedChanged="ToggleShowPassword"
              Content="{loc:Loc login-login-show-password}" />

    <Button Classes="AuthPrimary" IsDefault="True" Content="{loc:Loc login-login-button-log-in}"
            Command="{Binding OnLogInButtonPressed}">
      <Button.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsInputValid"/><Binding Path="!Busy"/></MultiBinding></Button.IsEnabled>
    </Button>

    <Grid ColumnDefinitions="*,Auto,*" Margin="0,17,0,11">
      <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource LauncherLineBrush}" />
      <TextBlock Grid.Column="1" Text="{loc:Loc login-orbitra-no-account}" Margin="12,0" FontSize="10" LetterSpacing="1.2" Foreground="{DynamicResource ThemeSubTextBrush}" />
      <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{DynamicResource LauncherLineBrush}" />
    </Grid>
    <Button Height="44" HorizontalAlignment="Stretch" Content="{loc:Loc login-login-button-register}"
            Command="{Binding RegisterPressed}" IsEnabled="{Binding !Busy}" />
    <Button Classes="AuthLink" HorizontalAlignment="Center" Margin="0,7,0,0"
            Content="{loc:Loc login-login-button-resend}" Command="{Binding ResendConfirmationPressed}" />
  </StackPanel>
</UserControl>
