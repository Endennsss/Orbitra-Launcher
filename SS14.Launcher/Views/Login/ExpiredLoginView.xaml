<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:login="clr-namespace:SS14.Launcher.ViewModels.Login" xmlns:loc="clr-namespace:SS14.Launcher.Localization"
 mc:Ignorable="d" x:Class="SS14.Launcher.Views.Login.ExpiredLoginView">
 <Design.DataContext><login:ExpiredLoginViewModel/></Design.DataContext>
 <StackPanel>
  <TextBlock Text="SESSION EXPIRED" FontSize="10" FontWeight="Bold" LetterSpacing="1.6" Foreground="{DynamicResource ThemeSubTextBrush}"/>
  <TextBlock Margin="0,8,0,0" Classes="NanoHeadingMedium" FontSize="28" Text="{loc:Loc login-expired-title}"/>
  <TextBlock Margin="0,9,0,24" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource ThemeSubTextBrush}" Text="{loc:Loc login-expired-message}"/>
  <TextBox Name="NameBox" Height="46" Padding="14,0" VerticalContentAlignment="Center" Text="{Binding Account.Username}" IsEnabled="False"/>
  <TextBox Name="PasswordBox" Height="48" Padding="14,0" VerticalContentAlignment="Center" Margin="0,10,0,0" Watermark="{loc:Loc login-login-password-watermark}" Text="{Binding Password}" PasswordChar="•"/>
  <Button Height="48" Margin="0,18,0,0" HorizontalAlignment="Stretch" Content="{loc:Loc login-expired-button-log-in}" Command="{Binding OnLogInButtonPressed}" IsEnabled="{Binding Password, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" IsDefault="True"/>
  <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
   <Button Margin="0,0,4,0" Content="{loc:Loc login-expired-button-forgot-password}" Command="{Binding ParentVM.SwitchToForgotPassword}" IsEnabled="{Binding !Busy}"/>
   <Button Grid.Column="1" Margin="4,0,0,0" Content="{loc:Loc login-expired-button-log-out}" Command="{Binding OnLogOutButtonPressed}"/>
  </Grid>
 </StackPanel>
</UserControl>
